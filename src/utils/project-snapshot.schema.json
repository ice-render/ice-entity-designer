{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ice-entity-designer project snapshot",
  "$comment": "结构契约，与 src/utils/project_schema.ts 的 validateProjectSnapshot() 保持同步。契约：serializeProject() 的产物必须永远满足本 schema；可选值（连线端点 id/position、字段 name、fields/relations 整体）允许缺省，仅在出现时校验类型。节点形状按 typeId 判定（缺省时按所在数组归位），因此 entities/relations 的 items 共用同一套节点定义，Entity/Relation 各自的必填项由 TS 校验器按 typeId 施加。",
  "type": "object",
  "required": ["entities"],
  "properties": {
    "version": {
      "type": "number"
    },
    "schemaVersion": {
      "type": "number"
    },
    "entities": {
      "type": "array",
      "items": { "$ref": "#/definitions/node" }
    },
    "relations": {
      "type": "array",
      "items": { "$ref": "#/definitions/node" }
    }
  },
  "definitions": {
    "node": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "typeId": { "type": "string" },
        "entityName": { "type": "string" },
        "relationType": { "type": "string" },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "type": { "type": "string" },
              "length": { "type": ["number", "string"] }
            }
          }
        },
        "links": {
          "type": "object",
          "properties": {
            "start": { "$ref": "#/definitions/linkSlot" },
            "end": { "$ref": "#/definitions/linkSlot" }
          }
        }
      }
    },
    "linkSlot": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "position": { "type": "string" }
      }
    }
  },
  "additionalProperties": true
}
