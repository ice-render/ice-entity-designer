{
  "author": "大漠穷秋",
  "name": "ice-entity-designer",
  "version": "0.0.32",
  "description": "An entity designer based on ice-render.",
  "repository": {
    "type": "git",
    "url": "https://github.com/ice-render/ice-entity-designer.git"
  },
  "browser": "dist/index.umd.js",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/types/react/index.d.mts",
        "default": "./dist/react.mjs"
      },
      "require": {
        "types": "./dist/types/react/index.d.ts",
        "default": "./dist/react.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "react.js",
    "react.d.ts"
  ],
  "scripts": {
    "start": "rollup -c -w  --environment NODE_ENV:development",
    "build": "npm run clean && npm run build:types && npm run build:js",
    "build:js": "rollup -c --environment NODE_ENV:production",
    "build:types": "tsc --emitDeclarationOnly && node scripts/vendor-engine-types.cjs && node scripts/emit-dmts.cjs",
    "clean": "rimraf dist",
    "prepare": "husky install",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "test:e2e": "playwright test",
    "pkg:lint": "publint",
    "pkg:types": "attw --pack .",
    "pkg:check": "npm run pkg:lint && npm run pkg:types",
    "lint": "eslint . --ext .ts,.tsx,.js,.cjs",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.cjs --fix",
    "pretty": "prettier src/**/* --write",
    "types:check": "tsc --noEmit",
    "types:watch": "npm run types:check -- --watch"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@babel/core": "7.17.8",
    "@babel/preset-env": "7.16.11",
    "@babel/preset-typescript": "7.9.0",
    "@commitlint/cli": "8.3.5",
    "@commitlint/config-conventional": "8.3.4",
    "@playwright/test": "1.63.0",
    "@rollup/plugin-commonjs": "21.0.2",
    "@rollup/plugin-json": "4.1.0",
    "@rollup/plugin-node-resolve": "13.1.3",
    "@rollup/plugin-strip": "^2.1.0",
    "@types/jest": "25.2.1",
    "@types/lodash": "4.14.180",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "@typescript-eslint/parser": "5.62.0",
    "antd": "5.26.5",
    "eslint": "8.57.1",
    "eslint-config-prettier": "8.10.0",
    "eslint-plugin-jest": "27.9.0",
    "eslint-plugin-prettier": "4.2.1",
    "eslint-plugin-react-hooks": "4.6.0",
    "http-server": "14.1.1",
    "husky": "8.0.3",
    "ice-render": "file:../ice-render",
    "jest": "25.4.0",
    "lint-staged": "15.5.2",
    "lodash": "4.17.21",
    "prettier": "2.8.8",
    "publint": "0.3.24",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rimraf": "3.0.2",
    "rollup": "2.70.1",
    "rollup-plugin-babel": "4.4.0",
    "rollup-plugin-license": "2.3.0",
    "rollup-plugin-terser": "5.3.0",
    "typescript": "4.6.2"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx,js,cjs}": "eslint --fix",
    "*.{json,md,yml,yaml}": "prettier --write",
    ".eslintrc": "prettier --write"
  },
  "keywords": [
    "canvas",
    "graphic"
  ],
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "npm": ">=6.4.1",
    "node": ">=10.13.0"
  },
  "license": "MIT"
}
