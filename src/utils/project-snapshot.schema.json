{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ice-entity-designer project snapshot",
  "$comment": "结构契约，与 src/utils/project_schema.ts 的 validateProjectSnapshot() 保持同步。契约：serializeProject() 的产物必须永远满足本 schema；可选值（连线端点 id/position、字段 name、fields/relations 整体）允许缺省，仅在出现时校验类型。",
  "type": "object",
  "required": ["entities"],
  "properties": {
    "version": {
      "type": "number"
    },
    "schemaVersion": {
      "type": "number"
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "entityName"],
        "properties": {
          "id": { "type": "string" },
          "typeId": { "type": "string" },
          "entityName": { "type": "string" },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "type": { "type": "string" },
                "length": { "type": ["number", "string"] }
              }
            }
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "typeId": { "type": "string" },
          "relationType": { "type": "string" },
          "links": {
            "type": "object",
            "properties": {
              "start": {
                "type": "object",
                "properties": {
                  "id": { "type": "string" },
                  "position": { "type": "string" }
                }
              },
              "end": {
                "type": "object",
                "properties": {
                  "id": { "type": "string" },
                  "position": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
